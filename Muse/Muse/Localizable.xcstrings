      }
    },
    "Saved looks you can switch back to.": {
      "extractionState": "stale",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendus enregistrés que vous pouvez réappliquer."
          }
        }
      }
    },
    "Saved settings for this photo. Restore one, or hold it up against what you have now.": {
      "extractionState": "stale",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages enregistrés pour cette photo. Rétablissez-en un, ou comparez-le avec vos réglages actuels."
          }
        }
      }
    },
    "Saved settings kept for before/after. Clicking one compares the photo against it — your edits are not changed.": {
      "extractionState": "stale",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages enregistrés pour l’avant/après. En cliquer un compare la photo avec celui-ci — vos retouches ne changent pas."
          }
        }
      }
    },
    "Saved settings you can return to. Nothing is duplicated — the photo keeps one set of edits, and switching parks the current ones as “Previous”.": {
      "extractionState": "stale",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages enregistrés auxquels vous pouvez revenir. Rien n’est dupliqué — la photo garde un seul jeu de retouches, et changer met les réglages actuels de côté sous « Précédent »."
          }
        }
      }
    },
    "Saves your current editing state": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre l’état actuel de vos retouches"
          }
        }
